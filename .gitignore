# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
.env*.local
# .env.example is a safe template (real secrets stay empty) — keep it tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/


# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin

# Docker volumes
.docker/

# SQLite databases
*.db
*.db-shm
*.db-wal

# Playwright MCP artifacts (screenshots / snapshots)
.playwright-mcp/

# Superpowers design/SDD artifacts (local only — never commit/push)
.superpowers/
docs/superpowers/

