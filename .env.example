# =================================================================
# Database Configuration (PostgreSQL)
# =================================================================
# Local dev: postgres://arion:arion_dev@localhost:5432/arion_agent
# Docker:    postgres://arion:arion_dev@db:5432/arion_agent

DATABASE_URL=postgres://arion:arion_dev@localhost:5432/arion_agent

# =================================================================
# Authentication Configuration (Better Auth)
# =================================================================
# Required: Secret key for session encryption and token signing.
# Generate one with: openssl rand -hex 32

BETTER_AUTH_SECRET=

# Required in production: Base URL for callbacks, redirects, and cookies.
# Defaults to the request origin if not set.

BETTER_AUTH_URL=http://localhost:3000

# Optional: Extra origins trusted by Better Auth (CORS / Origin checks), comma-separated.
# BETTER_AUTH_URL is auto-trusted; localhost:3000 is used as the dev fallback.
# Set this only for multi-domain deployments (e.g. apex + www, or a staging domain).
BETTER_AUTH_TRUSTED_ORIGINS=

# =================================================================
# Build Configuration
# =================================================================
# Set to 'true' when deploying with Docker or self-hosting on a VPS.
# This enables Next.js standalone output mode.

BUILD_STANDALONE=true

# =================================================================
# Timezone Configuration
# =================================================================
# Project-wide display/business timezone (default Beijing). Controls dashboard
# date display, agent "current time" awareness, and scheduler cron evaluation.
# Storage stays UTC; this only affects presentation/scheduling.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Shanghai

# =================================================================
# Error Tracking Configuration (Sentry) — Optional
# =================================================================
# Sentry is disabled by default. To enable it:
# 1. Create an account at https://sentry.io
# 2. Create a new project for Next.js
# 3. Fill in the values below and set NEXT_PUBLIC_SENTRY_DISABLED=false

NEXT_PUBLIC_SENTRY_DISABLED=true

# Sentry DSN — Found at: Settings > Projects > [Project] > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Organization & Project — Found at: Settings > Organization > General Settings
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=

# Auth token for source map uploads (optional)
SENTRY_AUTH_TOKEN=

# =================================================================
# Notes:
# =================================================================
# 1. Copy this file to '.env' for local development
# 2. Never commit the actual '.env' file to version control
# 3. Keep your secret keys private

# =================================================================
# Encryption Configuration
# =================================================================
# AES-256 key (base64, 32 bytes) for encrypting Feishu app secrets / LLM api keys.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
